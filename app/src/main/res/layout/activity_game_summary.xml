<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dice_dark_blue"
        android:padding="20dp">

    <!-- Divide a zona superior em duas colunas iguais. -->
    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/summaryCenterGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

    <!-- Identifica o dado que escolheu a categoria. -->
    <TextView
            android:id="@+id/summaryQuestionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="@string/label_question"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/summaryCenterGuide" />

    <!-- Identifica o dado que escolheu o formato de resposta. -->
    <TextView
            android:id="@+id/summaryAnswerLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:text="@string/label_answer"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/summaryCenterGuide"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mostra o número que saiu no dado Question. -->
    <TextView
            android:id="@+id/summaryQuestionDie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            app:layout_constraintTop_toBottomOf="@id/summaryQuestionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/summaryCenterGuide" />

    <!-- Mostra o número que saiu no dado Answer. -->
    <TextView
            android:id="@+id/summaryAnswerDie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            app:layout_constraintTop_toBottomOf="@id/summaryAnswerLabel"
            app:layout_constraintStart_toEndOf="@id/summaryCenterGuide"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mostra a categoria escolhida pelo dado Question. -->
    <TextView
            android:id="@+id/summaryQuestionType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_regular"
            app:layout_constraintTop_toBottomOf="@id/summaryQuestionDie"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/summaryCenterGuide" />

    <!-- Mostra o formato escolhido pelo dado Answer. -->
    <TextView
            android:id="@+id/summaryAnswerType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_regular"
            app:layout_constraintTop_toBottomOf="@id/summaryAnswerDie"
            app:layout_constraintStart_toEndOf="@id/summaryCenterGuide"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Calcula o fundo dos dois textos superiores para posicionar a contagem. -->
    <androidx.constraintlayout.widget.Barrier
            android:id="@+id/summaryTopContentBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="summaryQuestionType,summaryAnswerType" />

    <!-- Separa visualmente as informações do dado Question das do dado Answer. -->
    <View
            android:id="@+id/summaryDiceDivider"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="@id/summaryCenterGuide"
            app:layout_constraintTop_toTopOf="@id/summaryQuestionLabel"
            app:layout_constraintBottom_toBottomOf="@id/summaryTopContentBottom" />

    <!-- Mostra a posição atual, centrada entre os dados e as estatísticas. -->
    <TextView
            android:id="@+id/summaryQuestionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            app:layout_constraintTop_toBottomOf="@id/summaryTopContentBottom"
            app:layout_constraintBottom_toTopOf="@id/summaryProgress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.5"
    />

    <!-- Mantém a barra perto do contador e centra ambos no espaço disponível. -->
    <ProgressBar
            android:id="@+id/summaryProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="52dp"
            android:layout_marginBottom="16dp"
            android:max="15"
            android:indeterminate="false"
            android:progress="1"
            android:progressTint="@color/hot_pink"
            android:progressBackgroundTint="@color/progress_track"
            app:layout_constraintTop_toBottomOf="@id/summaryQuestionNumber"
            app:layout_constraintBottom_toTopOf="@id/summaryBottomContentTop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mantém o score à esquerda e alinha o seu centro vertical com o grupo do streak. -->
    <TextView
            android:id="@+id/summaryScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:gravity="start|center_vertical"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            app:layout_constraintTop_toTopOf="@id/summaryStreakGroup"
            app:layout_constraintBottom_toBottomOf="@id/summaryStreakGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/summaryCenterGuide" />

    <!-- O ícone de fogo e o streak ficam juntos no canto inferior direito. -->
    <LinearLayout
            android:id="@+id/summaryStreakGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/summaryStreakFlame"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_flame"
                android:contentDescription="@string/streak_flame_description" />

        <TextView
                android:id="@+id/summaryStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat_bold" />
    </LinearLayout>

    <!-- Define o limite superior das estatísticas inferiores para centrar contador e barra. -->
    <androidx.constraintlayout.widget.Barrier
            android:id="@+id/summaryBottomContentTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="summaryScore,summaryStreakGroup" />

</androidx.constraintlayout.widget.ConstraintLayout>
