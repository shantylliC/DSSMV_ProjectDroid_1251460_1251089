<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="24dp"
              android:background="@color/darkblue">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/leaderboard_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_extrabold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

    <!-- Mensagem apresentada depois de a partida e o Top 10 serem carregados. -->
    <TextView
            android:id="@+id/leaderboardGameResultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/dice_dark_blue"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="gone" />

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <ListView
                android:id="@+id/leaderboardList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/leaderboard_list_description"
                android:divider="@drawable/leaderboard_divider"
                android:dividerHeight="2dp" />

        <TextView
                android:id="@+id/leaderboardStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold" />

        <!-- Indica que o Top 10 está a ser carregado sem bloquear o ecrã. -->
        <LinearLayout
                android:id="@+id/leaderboardLoadingPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

            <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/white" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/leaderboard_loading"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/montserrat_bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Permite repetir a consulta se a ligação ao servidor falhar. -->
    <Button
            android:id="@+id/leaderboardRetryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/leaderboard_retry"
            android:visibility="gone" />

</LinearLayout>
