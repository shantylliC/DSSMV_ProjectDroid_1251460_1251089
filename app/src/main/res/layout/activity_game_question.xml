<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dice_dark_blue">

    <!-- Cabeçalho: número da pergunta à esquerda e tempo à direita. -->
    <LinearLayout
            android:id="@+id/questionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
                android:id="@+id/questionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_bold" />

        <TextView
                android:id="@+id/questionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_extrabold" />
    </LinearLayout>

    <!-- Marca o fim da zona da pergunta: 38% da altura do ecrã. -->
    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/answersStartGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.38" />

    <!-- Permite percorrer uma pergunta comprida sem cortar o texto. -->
    <ScrollView
            android:id="@+id/questionScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:importantForAccessibility="yes"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/questionHeader"
            app:layout_constraintBottom_toTopOf="@id/answersStartGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Permite percorrer as opções em ecrãs baixos ou quando o texto está ampliado. -->
    <ScrollView
            android:id="@+id/answersScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:importantForAccessibility="yes"
            app:layout_constraintTop_toTopOf="@id/answersStartGuide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <!-- Os botões dinâmicos mantêm o mesmo ID e podem crescer com o tamanho do texto. -->
        <LinearLayout
                android:id="@+id/answersContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
