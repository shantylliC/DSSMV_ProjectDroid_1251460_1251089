<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/DarkBlue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dice_dark_blue">

    <TextView
            android:id="@+id/instructionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:gravity="center"
            android:text="@string/shake_instruction"
            android:textColor="@color/white"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieDiceAnimationInvertido"
            android:layout_width="248dp"
            android:layout_height="229dp"
            android:scaleX="-1"
            app:lottie_rawRes="@raw/dice_animation"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.75" android:layout_marginEnd="16dp"
    />

    <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieDiceAnimation"
            android:layout_width="252dp"
            android:layout_height="233dp"
            app:lottie_rawRes="@raw/dice_animation"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_bias="0.1"
            app:layout_constraintVertical_bias="0.437"
    />

    <TextView
            android:id="@+id/questionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:translationY="65dp"
            android:text="@string/label_question"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_bold"
            app:layout_constraintStart_toStartOf="@id/lottieDiceAnimation"
            app:layout_constraintEnd_toEndOf="@id/lottieDiceAnimation"
            app:layout_constraintBottom_toTopOf="@id/lottieDiceAnimation" app:layout_constraintHorizontal_bias="0.485"/>
    <TextView
            android:id="@+id/answerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_answer"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_bold"
            app:layout_constraintStart_toStartOf="@id/lottieDiceAnimationInvertido"
            app:layout_constraintEnd_toEndOf="@id/lottieDiceAnimationInvertido"
            app:layout_constraintTop_toBottomOf="@id/lottieDiceAnimationInvertido" />

</androidx.constraintlayout.widget.ConstraintLayout>
