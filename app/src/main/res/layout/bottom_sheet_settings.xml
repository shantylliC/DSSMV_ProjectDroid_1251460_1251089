<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:background="@color/dice_dark_blue">

    <!-- Permite percorrer as definições em ecrãs baixos ou com texto ampliado. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

    <TextView
            android:id="@+id/settingsPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="16dp" />

    <TextView
            android:id="@+id/settingsBestStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginBottom="8dp" />

    <TextView
            android:id="@+id/settingsBestScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginBottom="20dp"/>

    <!-- Permite desligar os bips e sons de resposta sem afetar a vibração. -->
    <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settingsSoundSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/sound_effects_setting"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    <!-- Liga ou desliga apenas a música ambiente, sem alterar os efeitos sonoros do jogo. -->
    <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settingsMusicSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/background_music_setting"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    <!-- Permite desligar separadamente a vibração da contagem e do fim do tempo. -->
    <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settingsVibrationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/vibration_setting"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/weeklyLeaderboardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/leaderboard_label"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"
            app:cornerRadius="@dimen/button_corner_radius" />

    <!-- Termina a sessão local sem apagar a pontuação nem os recordes do jogador. -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/logout"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="@dimen/button_corner_radius"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
